index 0000000..ddf0299
--- /dev/null
+++ b/app/src/app/vouchers/voucher-form.component.ts
@@ -0,0 +1,15 @@
+import { Component, inject, input, output } from '@angular/core';
+import { VoucherService } from './voucher.service';
+
+@Component({ selector: 'app-voucher-form', templateUrl: './voucher-form.component.html' })
+export class VoucherFormComponent {
+  private readonly vouchers = inject(VoucherService);
+  readonly accountId = input.required<number>();
+  readonly saved = output<void>();
+  amount = 0;
+
+  submit(): void {
+    if (this.amount <= 0) return;
+    this.vouchers.record(this.accountId(), this.amount).subscribe(() => this.saved.emit());
+  }
+}
